generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  USER
  INSTITUTION
}

enum UserGender {
  male
  female
  other
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum CompanyUserStatus {
  PENDING
  ACTIVE
  DECLINED
}

enum CompanyRole {
  OWNER
  ADMIN
  TRAINER
  FINANCE
  EDITOR
}
enum ListingStatus {
  PENDING
  LISTED
  REJECTED
  APPROVED
  PUBLISHED
  DRAFT
}


enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum VerificationReview {
  NONE
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum VerificationSource {
  SUBMISSION
  REGISTRY
}

enum Profession {
  PSIKOLOG
  PSIKIATER
  KONSELOR
}

enum SessionMode {
  ONLINE
  IN_PERSON
}

enum CentreKind {
  KLINIK
  RUMAH_SAKIT
  PUSKESMAS
  PUSAT_KONSELING
}

enum CareCentreRole {
  OWNER
  ADMIN
}

enum CareCentreUserStatus {
  PENDING
  ACTIVE
  DECLINED
}

enum NotificationStatus {
  PENDING
  ACTIVE
  DECLINED
  READ
}

enum NotificationType {
  COMPANY_INVITE
  COMPANY_ACCEPTED
  COMPANY_DECLINED
  GENERAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventRegistrationType {
  INTERNAL
  EXTERNAL
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
}

enum ArticleType {
  BLOG
  NEWS
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleCategory {
  CORPORATE
  EXECUTIVE
  INSIGHT
  UPDATE
  EVENT
}

enum AttendeeFieldType {
  TEXT
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
}

enum ContactMessageStatus {
  UNREAD
  READ
  REPLIED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum SolutionType {
  PLATFORM
  PRODUCT
  SERVICE
  PROGRAM
  TRAINING
  ASSESSMENT
  OTHER
}

model Categories {
  id            Int             @id @default(autoincrement())
  slug          String          @db.VarChar(255)
  title         String          @db.VarChar(255)
  publicId      String?         @db.VarChar(255)
  photo         String?
  content       String?         @db.Text
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  CategoriesSub CategoriesSub[]
}

model CategoriesSub {
  id           Int         @id @default(autoincrement())
  categoriesId Int
  slug         String      @db.VarChar(255)
  title        String      @db.VarChar(255)
  content      String?     @db.Text
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  categories   Categories? @relation(fields: [categoriesId], references: [id])

  @@unique([categoriesId, slug])
  @@index([categoriesId])
}

model AdminAccess {
  id Int @id @default(autoincrement())

  userId Int @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role AdminRole @default(ADMIN)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model User {
  id Int @id @default(autoincrement())

  email    String @unique @db.VarChar(255)
  username String @unique @db.VarChar(100)
  name     String @db.VarChar(255)

  password String? @db.VarChar(255)

  emailVerified             Boolean   @default(false)
  emailVerifiedAt           DateTime?
  emailVerificationToken    String?   @unique @db.VarChar(255)
  emailVerificationExpires  DateTime?
  emailResendCooldown       DateTime?
  emailVerificationAttempts Int       @default(0)

  resetPasswordToken   String?   @unique @db.VarChar(255)
  resetPasswordExpires DateTime?

  phoneNumber              String?   @unique @db.VarChar(50)
  phoneVerified            Boolean   @default(false)
  phoneVerificationCode    String?   @db.VarChar(20)
  phoneVerificationExpires DateTime?

  bio      String? @db.Text
  jobTitle String? @db.VarChar(255)
  jobName  String? @db.VarChar(255)

  gender UserGender?

  publicId String? @db.VarChar(255)
  photo    String? @db.VarChar(500)

  instagram String? @db.VarChar(255)
  facebook  String? @db.VarChar(255)
  linkedin  String? @db.VarChar(255)

  role      UserRole  @default(USER)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  companies             CompanyUser[]
  professional          Professional?
  adminAccess           AdminAccess?
  careCentreMemberships CareCentreUser[]
  orders                Order[]
  notifications         Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
  @@index([deletedAt])
}

model Company {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  publicId    String? @unique @db.VarChar(255)
  description String? @db.Text

  logo    String? @db.VarChar(500)
  website String? @db.VarChar(500)
  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(50)

  instagram String? @db.VarChar(255)
  facebook  String? @db.VarChar(255)
  linkedin  String? @db.VarChar(255)

  location   String? @db.Text
  city       String? @db.VarChar(100)
  province   String? @db.VarChar(100)
  country    String? @db.VarChar(100)
  postalCode String? @db.VarChar(20)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  status       CompanyStatus      @default(PENDING)
  verification VerificationStatus @default(UNVERIFIED)

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     CompanyUser[]
  solutions Solution[]
  events    Event[]

  media Media[]

  @@index([status, isFeatured])
  @@index([city, province])
  @@index([deletedAt])
}

model CompanyUser {
  id Int @id @default(autoincrement())

  userId    Int
  companyId Int

  role   CompanyRole
  status CompanyUserStatus @default(PENDING)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@index([userId, status])
}

model CareCentre {
  id          Int        @id @default(autoincrement())
  slug        String     @unique @db.VarChar(255)
  name        String     @db.VarChar(255)
  kind        CentreKind
  photoUrl    String?    @db.VarChar(500)
  publicId    String? @db.VarChar(255)
  description String?    @db.Text

  street     String  @db.VarChar(255)
  city       String  @db.VarChar(100)
  province   String  @db.VarChar(100)
  postalCode String  @db.VarChar(10)
  phone      String  @db.VarChar(25)
  website    String? @db.VarChar(255)
  country    String? @db.VarChar(100)

  acceptsBpjs Boolean @default(false)
  timeZone    String  @default("Asia/Jakarta") @db.VarChar(50)
  openingNote String? @db.VarChar(500)
  latitude    Float?
  longitude   Float?
  appointmentAvailable Boolean @default(false)
  onlineAvailable      Boolean @default(false)
  isFeatured Boolean @default(false)

  listingStatus          ListingStatus       @default(PENDING)
  verificationReview     VerificationReview  @default(NONE)
  verificationCheckedOn  DateTime?
  verificationValidUntil DateTime?
  verificationSource     VerificationSource?
  verificationAdminId    Int?
  verificationNote       String?             @db.VarChar(500)
  permitType       String?   @db.VarChar(100)
  permitNumber     String?   @db.VarChar(100)
  permitValidUntil DateTime?

  openingHours CareCentreOpeningHour[]
  services     CareCentreService[]
  users        CareCentreUser[]
  media        Media[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([listingStatus, deletedAt])
  @@index([kind, city])
  @@index([city])
}

model CareCentreOpeningHour {
  id       Int        @id @default(autoincrement())
  centreId Int
  centre   CareCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  day    Int
  opens  String? @db.VarChar(5)
  closes String? @db.VarChar(5)

  createdAt DateTime @default(now())

  @@unique([centreId, day])
}

model CareCentreUser {
  id           Int                  @id @default(autoincrement())
  userId       Int
  centreId     Int
  role         CareCentreRole       @default(OWNER)
  status       CareCentreUserStatus @default(PENDING)
  activeUserId Int?                 @unique

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  centre CareCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, centreId])
  @@index([centreId])
  @@index([userId])
}

model CareCentreService {
  centreId  Int
  serviceId Int

  centre  CareCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([centreId, serviceId])
  @@index([serviceId])
}

model Service {
  id       Int     @id @default(autoincrement())
  slug     String  @unique @db.VarChar(255)
  name     String  @db.VarChar(255)
  isActive Boolean @default(true)

  centres CareCentreService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Solution {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  publicId String? @db.VarChar(255)

  tagline     String? @db.VarChar(255)
  description String? @db.LongText

  type SolutionType

  coverImage String? @db.VarChar(500)
  logo       String? @db.VarChar(500)

  listingStatus ListingStatus      @default(PENDING)
  verification  VerificationStatus @default(UNVERIFIED)

  isFeatured Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  categories SolutionCategoryMap[]
  audiences  SolutionAudienceMap[]

  media Media[]

  @@index([companyId])
  @@index([type, listingStatus])
  @@index([listingStatus, isFeatured])
  @@index([deletedAt])
}

model SolutionCategory {
  id Int @id @default(autoincrement())

  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  description String? @db.Text
  icon        String? @db.VarChar(255)

  orderIndex Int     @default(0)
  isActive   Boolean @default(true)

  solutions SolutionCategoryMap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, orderIndex])
}

model SolutionCategoryMap {
  solutionId Int
  categoryId Int

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  category SolutionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([solutionId, categoryId])
  @@index([categoryId])
}


model SolutionAudience {
  id Int @id @default(autoincrement())

  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  isActive Boolean @default(true)

  solutions SolutionAudienceMap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SolutionAudienceMap {
  solutionId Int
  audienceId Int

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  audience SolutionAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@id([solutionId, audienceId])
  @@index([audienceId])
}


model Media {
  id Int @id @default(autoincrement())

  url      String  @db.VarChar(1000)
  publicId String? @db.VarChar(500)

  type MediaType @default(IMAGE)

  altText String? @db.VarChar(255)

  companyId      Int?
  solutionId     Int?
  careCentreId   Int?
  professionalId Int?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  careCentre CareCentre? @relation(fields: [careCentreId], references: [id], onDelete: Cascade)

  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([companyId, sortOrder])
  @@index([solutionId, sortOrder])
  @@index([careCentreId, sortOrder])
  @@index([professionalId, sortOrder])
}


model Notification {
  id Int @id @default(autoincrement())

  userId Int

  type    NotificationType
  title   String           @db.VarChar(255)
  message String           @db.Text

  data Json?

  isRead Boolean @default(false)

  status NotificationStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([status])
}


model HeroSlider {
  id Int @id @default(autoincrement())

  title       String? @db.VarChar(255)
  subtitle    String? @db.VarChar(255)
  description String? @db.Text

  image    String? @db.VarChar(500)
  publicId String? @db.VarChar(500)

  buttonText String? @db.VarChar(255)
  buttonUrl  String? @db.VarChar(500)

  alignText String @default("left") @db.VarChar(20)

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model WhyUs {
  id Int @id @default(autoincrement())

  title       String  @db.VarChar(255)
  description String? @db.Text

  image         String? @db.VarChar(500)
  publicId      String? @db.VarChar(500)
  hoverImage    String? @db.VarChar(500)
  hoverPublicId String? @db.VarChar(500)

  type WhyUsType @default(WHY_US)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WhyUsType {
  WHY_US
  SERVICES
  VISION
  MISSION
  OTHER
}

model AboutSection {
  id Int @id @default(autoincrement())

  title       String @db.VarChar(255)
  description String @db.Text

  imageUrl String? @db.VarChar(500)
  publicId String? @db.VarChar(500)

  orderIndex Int @default(0)

  imagePosition String @default("left") @db.VarChar(20)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, orderIndex])
}

model Event {
  id Int @id @default(autoincrement())

  title String @db.VarChar(255)
  slug  String @unique @db.VarChar(255)

  description String @db.LongText

  location String? @db.VarChar(500)

  startDate DateTime
  endDate   DateTime

  timeZone String @default("Asia/Jakarta") @db.VarChar(100)

  price    Int    @default(0)
  currency String @default("IDR") @db.VarChar(10)

  quota Int?

  externalUrl String? @db.VarChar(500)

  registrationType EventRegistrationType @default(INTERNAL)

  coverImage  String? @db.VarChar(500)
  publicId    String? @db.VarChar(255)
  isPublished Boolean @default(false)

  status EventStatus @default(DRAFT)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  categoryId Int
  category   EventCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders         Order[]
  attendeeFields EventAttendeeField[]
  industries     EventIndustry[]

  @@index([companyId, status, startDate])
  @@index([categoryId, status])
  @@index([status, startDate])
  @@index([deletedAt])
}


model EventCategory {
  id Int @id @default(autoincrement())

  name String @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  isActive Boolean @default(true)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Industry {
  id Int @id @default(autoincrement())

  name String @unique @db.VarChar(255)
  slug String @unique @db.VarChar(255)

  isActive Boolean @default(true)

  events EventIndustry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventIndustry {
  eventId    Int
  industryId Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([eventId, industryId])
  @@index([industryId])
}


model Article {
  id Int @id @default(autoincrement())

  publicId String @unique @default(uuid())

  slug  String @unique @db.VarChar(255)
  title String @db.VarChar(255)

  excerpt String? @db.Text
  content String? @db.LongText

  coverImage String? @db.VarChar(500)

  type     ArticleType
  category ArticleCategory

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([type, status])
  @@index([isFeatured, status])
  @@index([deletedAt])
}

model Order {
  id String @id @default(cuid())

  eventId Int
  userId  Int

  event Event @relation(fields: [eventId], references: [id])

  user User @relation(fields: [userId], references: [id])

  amount   Int
  currency String @default("IDR") @db.VarChar(10)

  status OrderStatus @default(PENDING)

  invoiceId  String? @unique @db.VarChar(255)
  invoiceUrl String? @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paidAt DateTime?

  paymentLogs PaymentLog[]
  tickets     Ticket[]

  @@index([userId, status])
  @@index([eventId, status])
  @@index([status, createdAt])
}

model PaymentLog {
  id String @id @default(cuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider String @db.VarChar(50)

  status PaymentStatus

  payload Json

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([provider, status])
}

model Ticket {
  id String @id @default(cuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  attendeeName  String  @db.VarChar(255)
  attendeeEmail String  @db.VarChar(255)
  attendeePhone String? @db.VarChar(50)

  attendeeData Json

  code String @unique @db.VarChar(100)

  qrCode String? @db.Text

  isCheckedIn Boolean   @default(false)
  checkedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([attendeeEmail])
  @@index([isCheckedIn, checkedAt])
}


model EventAttendeeField {
  id String @id @default(cuid())

  eventId Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label    String            @db.VarChar(255)
  key      String            @db.VarChar(100)
  type     AttendeeFieldType
  required Boolean           @default(false)

  options Json?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@unique([eventId, key])
  @@index([eventId, sortOrder])
}

model ContactMessage {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(255)
  email       String  @db.VarChar(255)
  phoneNumber String? @db.VarChar(50)

  subject String @db.VarChar(255)
  message String @db.Text

  status ContactMessageStatus @default(UNREAD)

  repliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}


model Professional {
  id     Int   @id @default(autoincrement())
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  slug        String     @unique @db.VarChar(255)
  fullName    String     @db.VarChar(255)
  credentials String     @db.VarChar(255)
  profession  Profession
  headline    String     @db.VarChar(500)
  bio         String?    @db.Text
  photoUrl    String?    @db.VarChar(500)
  publicId String? @db.VarChar(255)
  baseCity     String @db.VarChar(100)
  baseProvince String @db.VarChar(100)
  languages Json?

  yearsOfExperience Int @default(0)
  startingPriceIdr Int?

  listingStatus          ListingStatus       @default(PENDING)
  verificationReview     VerificationReview  @default(NONE)
  verificationCheckedOn  DateTime?
  verificationValidUntil DateTime?
  verificationSource     VerificationSource?
  verificationAdminId    Int?
  verificationNote       String?             @db.VarChar(500)
  licenceType       String?   @db.VarChar(100)
  licenceNumber     String?   @db.VarChar(100)
  licenceValidUntil DateTime?

  services ProfessionalService[]
  areas    ProfessionalAreaOfSupport[]
  media    Media[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([listingStatus, deletedAt])
  @@index([profession])
  @@index([baseCity])
}
model ProfessionalService {
  id             Int          @id @default(autoincrement())
  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  name            String      @db.VarChar(255)
  mode            SessionMode
  durationMinutes Int         @default(60)
  priceIdr        Int

  createdAt DateTime @default(now())

  @@index([professionalId])
}

model AreaOfSupport {
  id       Int     @id @default(autoincrement())
  slug     String  @unique @db.VarChar(255)
  name     String  @db.VarChar(255)
  isActive Boolean @default(true)

  professionals ProfessionalAreaOfSupport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfessionalAreaOfSupport {
  professionalId Int
  areaId         Int

  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  area         AreaOfSupport @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([professionalId, areaId])
  @@index([areaId])
}
